---
import Layout from '../layouts/Layout.astro';
import ProductShowcase from '../components/ProductShowcase.astro';
import SectionLabel from '../components/SectionLabel.astro';
import Arrow from '../components/Arrow.astro';
import { products, projects, releases, labs, url, dateText, typeName } from '../lib/content';
---
<Layout active="Home">
  <section class="hero container"><div class="hero-grid" aria-hidden="true"></div><div class="hero-topline eyebrow"><span>Independent products & experiments</span><span class="hero-coordinate">AI / 014</span></div>
    <h1 class="hero-title">AI014<span class="hero-period">.</span></h1>
    <div class="hero-bottom"><h2>有意思的 AI，<br /><span>做点有意思的东西。</span></h2><div class="hero-aside"><p>Ideas / Products / Experiments</p><a class="explore" href="#products" data-magnetic><span>Explore</span><span class="circle-arrow">↓</span></a></div></div>
    <div class="hero-foot"><span>先做有意思的东西，再决定它属于什么类别。</span><span aria-hidden="true">SCROLL TO EXPLORE <span class="scroll-line"></span></span></div>
  </section>
  <section class="container section" id="products"><SectionLabel number="01" label="Featured Products" href={url('/products/')} action="All products" />{products.filter(p=>p.featured).map((product,index)=><ProductShowcase product={product} index={index} />)}</section>
  <section class="container section" id="projects"><SectionLabel number="02" label="Selected Projects" href={url('/projects/')} action="All projects" />{projects.filter(p=>p.featured).map(project=><a class="project-row" href={url(`/projects/${project.slug}/`)} data-reveal><div class="project-row-main"><span class="eyebrow">{typeName(project.type)}{project.category&&` / ${project.category}`}</span><h3>{project.name}</h3><p>{project.description}</p></div><span class="project-orbit" aria-hidden="true"><span>{project.name.slice(0,1)}</span></span><span class="project-go"><Arrow diagonal /></span></a>)}</section>
  <section class="container section lab-home" data-reveal><SectionLabel number="03" label="The Lab" href={url('/lab/')} action="Enter Lab" /><div class="lab-panel"><div><span class="eyebrow">A space for what comes next</span><h3>留一点空间，<br /><span>给还没成形的想法。</span></h3></div><div class="lab-aside"><span class="lab-symbol" aria-hidden="true">[ &nbsp; ]</span><p>{labs.length ? `${labs.length} experiments` : 'Nothing here yet.'}</p></div></div></section>
  <section class="container section"><SectionLabel number="04" label="Latest Releases" href={url('/releases/')} action="Release history" />{releases.length ? releases.slice(0,3).map(release=><a class="release-preview" href={url(`/products/${products.find(p=>p.id===release.productId)?.slug}/`)}><span>{products.find(p=>p.id===release.productId)?.name}</span><span>{release.version}</span><time>{dateText(release.date)}</time><Arrow /></a>) : <div class="empty-release"><span class="empty-mark" aria-hidden="true">—</span><p>新的发布，会记录在这里。</p><span class="eyebrow">No releases yet</span></div>}</section>
  <section class="container home-about" data-reveal><span class="eyebrow">About AI014</span><div><h2>方向可以改变。<br />有意思，就值得一试。</h2><p>AI014 是一个用于创造、发布和记录<br class="desktop-break" />各种有意思尝试的独立空间。</p><a class="text-link" href={url('/about/')}>More about AI014<Arrow /></a></div></section>
</Layout>
