---
import Layout from '../../layouts/Layout.astro';
import ASharePanel from '../../components/ASharePanel.astro';
import { categories, provinces, ranges } from '../../lib/trends/model';
import { instruments, retrievedAt, worldBankVintage, worldBankPublished, nationalProduceRefreshPending, nationalProduceCount, nationalProduceObservationCount, nationalProduceStart, nationalProduceEnd } from '../../lib/trends/catalog';
import '../../styles/trends.css';
---
<Layout title="Trends 趋势观察 — AI014" description="房价、租金、股票、商品、贵金属与外汇的趋势观察。真实来源、明确日期、透明覆盖范围。" active="Trends">
<div class="trends container">
 <header class="trends-heading"><div><p class="eyebrow">AI014 / MARKET OBSERVATORY</p><h1>趋势观察<span>Trends</span></h1><p class="intro">看见变化，先看清数据。</p></div><a href="#coverage" class="source-shortcut">数据与覆盖说明 ↗</a></header>
 <div class="trends-note"><span class="status-dot"></span>历史参考数据 · 非实时行情 <span data-a-share-hidden>最近成功获取：{retrievedAt || '尚未导入'}</span></div>
 <nav class="category-tabs" aria-label="市场分类">{categories.map(([id,label])=><button type="button" data-category={id} aria-pressed={id==='all'}>{label}</button>)}</nav>
 <div class="mobile-category"><label for="category-select">选择市场</label><select id="category-select">{categories.map(([id,label])=><option value={id}>{label}</option>)}</select><a id="market-jump" href="#market-title">选品种 ↓</a></div><div class="trend-toolbar" data-a-share-hidden><label class="search-field"><span aria-hidden="true">⌕</span><input id="trend-search" type="search" placeholder="搜索品种、代码或数据来源" aria-label="搜索品种、代码或数据来源" /></label><button id="region-open" type="button">全国 / 地区筛选 ⌄</button><button id="favorites-only" type="button" aria-pressed="false">☆ 我的收藏</button></div>
 <ASharePanel />
 <div class="unit-toolbar" data-a-share-hidden><div role="group" aria-label="价格计量单位"><span>计价显示</span><button type="button" data-unit="original" aria-pressed="false">原始单位 / 公斤</button><button type="button" data-unit="jin" aria-pressed="true">按斤</button></div><p>1斤 = 0.5公斤 · 公斤价减半 · 其他单位保持不变</p></div>
 <section id="selected-instrument" class="chart-panel" tabindex="-1" aria-labelledby="instrument-title">
  <div class="instrument-top"><div><p class="eyebrow" id="instrument-symbol"></p><h2 id="instrument-title">选择观察品种</h2><p id="instrument-source" class="muted"></p></div><button id="detail-favorite" type="button" aria-label="收藏当前品种">☆ 收藏</button></div>
  <div class="metrics"><div><p class="metric-label" id="value-label">最新参考值</p><strong id="last-value">—</strong><span id="instrument-unit"></span></div><div><p class="metric-label">所选区间变化</p><strong id="period-change">—</strong><span id="period-dates"></span></div><div class="metric-vintage"><p class="metric-label">数据截至</p><strong id="last-date">—</strong><span id="frequency"></span></div></div>
  <p id="quote-range" class="quote-range" hidden></p><p id="unit-detail" class="unit-detail"></p><div class="range-controls"><div class="range-tabs" aria-label="历史区间">{ranges.map(([range,label])=><button type="button" data-range={range} aria-pressed={range==='1m'}>{label}</button>)}</div><p id="range-status" role="status" aria-live="polite"></p></div>
  <div id="chart-area"><svg id="trend-chart" viewBox="0 0 1000 310" role="img" aria-label="所选品种历史参考值折线图"><defs><linearGradient id="gold-fill" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#d9c57d" stop-opacity=".16"/><stop offset="100%" stop-color="#d9c57d" stop-opacity="0"/></linearGradient></defs><g id="chart-grid"></g><path id="chart-fill" fill="url(#gold-fill)"/><path id="chart-line" fill="none" stroke="#e5cc7d" stroke-width="2.5" vector-effect="non-scaling-stroke"/><g id="chart-labels"></g><g id="chart-markers"></g><title id="chart-point-title"></title></svg><div id="chart-empty" hidden><span id="chart-empty-title">暂无已核实序列</span><p id="chart-empty-copy">覆盖说明见下方。不用模拟曲线替代真实行情。</p></div></div>
  <label id="chart-inspector" class="chart-inspector">逐期查看 <input id="point-slider" type="range" min="0" max="1" value="1" aria-label="选择图表日期" /><output id="point-readout"></output><a id="point-source" target="_blank" rel="noopener noreferrer">本期来源 ↗</a></label><div class="chart-bottom"><p id="chart-caption" class="muted"></p></div>
  <p id="instrument-coverage" class="coverage-note"></p>
 </section>
 <section class="market-panel" data-a-share-hidden aria-labelledby="market-title"><div class="market-heading"><div><p class="eyebrow">WATCH / COMPARE / EXPLORE</p><h2 id="market-title">市场一览</h2></div><span id="result-count" role="status" aria-live="polite"></span></div><p class="table-note">不同计价单位不作绝对价格排名；区间涨跌仅对有数据品种计算。</p><div class="mobile-sort"><label for="mobile-sort">排列</label><select id="mobile-sort"><option value="name">名称 ↑</option><option value="change-desc">区间变化 ↓</option><option value="change-asc">区间变化 ↑</option></select></div><div class="table-scroll"><table><thead><tr><th><button data-sort="name" type="button">品种 ↕</button></th><th>最新参考值</th><th><button data-sort="change" type="button">区间变化 ↕</button></th><th>数据截至</th><th>状态</th><th>收藏</th></tr></thead><tbody id="market-rows"></tbody></table></div><p id="no-results" hidden>没有符合条件的品种。试试清除搜索或收藏筛选。</p></section>
 <section id="coverage" class="coverage-panel"><div><p class="eyebrow">DATA, WITH CONTEXT</p><h2>每一条曲线，都应该有来处。</h2></div><div><p>全国蔬果：商务部商务预报30种蔬菜单品、6种水果单品的全国批发周价，当前收录{nationalProduceCount}项、{nationalProduceStart}至{nationalProduceEnd}，共{nationalProduceObservationCount}个真实周度观测。信息来源：商务预报。日期沿用源站周度标签，不是当日现货或全国统一定价；并未细分产地、等级、品牌及包装。另有国家统计局50种重要生产资料旬度市场均价、农业农村部9项单品食品批发均价。蔬菜与水果仅展示全国单品资料，监测篮子不作为单品展示。具体起止日与观测数以所选品种为准；周度资料不补成每日价格，其他公告的缺失日期也不插值。另有 ECB 外汇历史参考汇率，以及世界银行黄金、白银的月度历史均价（截至 {worldBankVintage}，{worldBankPublished} 发布，非现价）。价格保留来源原始数值；选择“按斤”时，元/公斤、元/千克按1斤=0.5公斤换算，其他单位不变。涨跌由所选区间首尾值计算，不代表投资回报。</p><p>房价与租金分开展示。国家统计局 70 城住宅价格指数不能代表全国所有省市区县，也不能等同于每平方米成交价。A股指数与个股历史日线由 TradingView 官方组件直接提供（以 EOD 收盘覆盖为主，更新频率以图内为准），打开A股分类即可查看；其可用范围、日期与状态以图内标注为准。区县级房价、租金、港美股及品牌商品零售价仍待接入。食品批发均价不能替代超市或电商的具体商品报价。</p><p>商务部单品周价每7天最多成功刷新一次，使用缓存并保留最后核验值。系统每个工作日尝试读取国家统计局、农业农村部的最新公告，并更新 ECB；世界银行按月发布，新月份发布前保留上一期。数据通过自动构建发布，可能延迟；更新失败时保留已验证值并标记状态。超过预期时限显示“数据滞后”。{nationalProduceRefreshPending && <span>全国单品周价已按官方接口核验，自动更新链路仍待首次成功运行确认。</span>}这不是盘中实时行情。收藏仅保存在此浏览器。数据用于观察研究，不构成投资建议。</p><a href="https://cif.mofcom.gov.cn/cif/html/dataCenter/" target="_blank" rel="noopener noreferrer">信息来源：商务预报 · 全国单品周价 ↗</a><a href="https://www.ecb.europa.eu/stats/policy_and_exchange_rates/euro_reference_exchange_rates/html/index.en.html" target="_blank" rel="noopener noreferrer">查看 ECB 数据说明 ↗</a></div></section>
 <noscript><p class="trends-note">请启用 JavaScript 使用筛选与图表。数据来源及覆盖说明仍可在本页阅读。</p></noscript>
</div>
<dialog id="region-dialog" class="region-dialog"><form method="dialog"><div class="dialog-heading"><h2>地区筛选</h2><button value="cancel" aria-label="关闭地区筛选">✕</button></div><p>用于房价与租金。地区名称可直接输入；未接入区域会明确显示缺少数据。</p><label>省 / 自治区 / 直辖市<select id="region-province"><option value="">全国</option>{provinces.map(p=><option>{p}</option>)}</select></label><label>城市<input id="region-city" placeholder="例如：武汉" maxlength="40" /></label><label>区 / 县<input id="region-district" placeholder="例如：武昌区" maxlength="40" /></label><p class="muted">选择地区不代表已有该地区数据。不会用上级地区数据替代区县数据。</p><div class="dialog-actions"><button value="cancel">取消</button><button id="region-reset" type="button">重置</button><button id="region-apply" value="apply">应用地区</button></div></form></dialog>
<script is:inline type="application/json" id="trend-data" set:html={JSON.stringify(instruments).replace(/</g,'\\u003c')}></script>
<script>import '../../lib/trends/dashboard';</script>
</Layout>
