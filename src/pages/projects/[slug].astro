---
import Layout from '../../layouts/Layout.astro';import Arrow from '../../components/Arrow.astro';import Media from '../../components/Media.astro';
import {projects,url,typeName,statusName} from '../../lib/content';import type {Project} from '../../lib/types';
export function getStaticPaths(){return projects.map(project=>({params:{slug:project.slug},props:{project}}));}
const {project}=Astro.props as {project:Project};
---
<Layout active="Projects" title={`${project.name} — AI014`} description={project.description || `${project.name} — AI014 Project`} image={project.cover}>
  <div class="container detail-top"><a class="text-link" href={url('/projects/')}><span aria-hidden="true">←</span>All projects</a><span class="eyebrow">AI014 / Project</span></div>
  <header class="container project-detail-heading"><span class="eyebrow">{typeName(project.type)}{project.category&&` / ${project.category}`}</span><h1>{project.name}<span class="blue">.</span></h1><p>{project.description}</p><div class="project-links">{project.visitUrl&&<a class="button" href={url(project.visitUrl)}>Visit website<Arrow diagonal/></a>}{project.repositoryUrl&&<a class="text-link" href={url(project.repositoryUrl)}>Repository<Arrow diagonal/></a>}</div></header>
  <div class="container project-details">{project.tags.length>0&&<div class="tags">{project.tags.map(tag=><span>{tag}</span>)}</div>}<dl class="metadata project-metadata"><div><dt>Type</dt><dd>{typeName(project.type)}{project.category&&` / ${project.category}`}</dd></div><div><dt>Status</dt><dd>{project.status?statusName(project.status):'—'}</dd></div><div><dt>Year</dt><dd>{project.year||'—'}</dd></div></dl>{project.cover&&<Media src={project.cover} alt={project.name} eager/>}{project.images.length>0&&<div class="screenshot-grid">{project.images.map(s=><figure><Media {...s}/><figcaption>{s.alt}</figcaption></figure>)}</div>}{project.technicalNotes&&<section class="detail-section"><h2>技术说明</h2><p class="prose">{project.technicalNotes}</p></section>}{project.developmentNotes.length>0&&<section class="detail-section"><h2>开发记录</h2><ul class="changelog">{project.developmentNotes.map(note=><li>{note}</li>)}</ul></section>}</div>
</Layout>
