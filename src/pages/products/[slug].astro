---
import Layout from '../../layouts/Layout.astro';
import Arrow from '../../components/Arrow.astro';
import Media from '../../components/Media.astro';
import ReleaseItem from '../../components/ReleaseItem.astro';
import { products, url, typeName, platformName, statusName, productReleases, dateText } from '../../lib/content';
import type { Product } from '../../lib/types';
export function getStaticPaths(){return products.map(product=>({params:{slug:product.slug},props:{product}}));}
const {product}=Astro.props as {product:Product};
const history=productReleases(product.id), latest=history[0];
const releaseFiles=latest?.files || [];
const primaryVisit=latest?.visitUrl || product.visitUrl;
const nextProduct=products[(products.findIndex(p=>p.id===product.id)+1)%products.length];
const social=product.socialImage || product.cover;
---
<Layout active="Products" title={`${product.name} — AI014`} description={product.subtitle || `${product.name}，AI014 的 ${typeName(product.type)}。${product.platforms.map(platformName).join(' / ')}。`} image={social}>
  <div class="container detail-top"><a class="text-link back-link" href={url('/products/')}><span aria-hidden="true">←</span>All products</a><span class="eyebrow">AI014 / Product</span></div>
  <header class="container product-heading"><div class="product-identity">{product.icon ? <Media src={product.icon} alt={`${product.name}图标`} width={80} height={80} eager /> : <span class="icon-placeholder" aria-label="图标尚未提供">＋</span>}<div class="eyebrow">{typeName(product.type)}<span class="slash">/</span>{product.platforms.map(platformName).join(' · ')}</div></div><h1>{product.name}<span class="blue">.</span></h1>{product.subtitle && <p>{product.subtitle}</p>}{product.status && <span class="status">{statusName(product.status)}</span>}</header>
  <div class="container product-detail-grid"><div class="detail-content"><div class="detail-cover" style={`view-transition-name: visual-${product.slug}`}>{product.cover?<Media src={product.cover} alt={product.name} eager />:<div class="empty-art"><span class="art-registration">AI014 / {typeName(product.type).toUpperCase()}</span><span class="art-glyph" aria-hidden="true">{product.name}</span><span class="art-baseline">产品封面尚未提供</span><i class="crosshair crosshair-a" aria-hidden="true"></i><i class="crosshair crosshair-b" aria-hidden="true"></i></div>}</div>
    <section class="detail-section"><div class="detail-section-title"><h2>关于产品</h2><span>Overview</span></div>{product.description?<p class="prose">{product.description}</p>:<p class="muted">产品介绍尚未提供。</p>}{product.tags.length>0&&<div class="tags">{product.tags.map(tag=><span>{tag}</span>)}</div>}</section>
    <section class="detail-section"><div class="detail-section-title"><h2>产品截图</h2><span>Screenshots</span></div>{product.screenshots.length?<div class="screenshot-grid">{product.screenshots.map(s=><figure><Media {...s}/><figcaption>{s.alt}</figcaption></figure>)}</div>:<div class="empty-inline"><span aria-hidden="true">＋</span><p>截图尚未提供。</p></div>}</section>
    <section class="detail-section"><div class="detail-section-title"><h2>更新日志</h2><span>Changelog</span></div>{latest?.changelog.length?<ul class="changelog">{latest.changelog.map(item=><li>{item}</li>)}</ul>:<p class="muted">暂无更新日志。</p>}</section>
    <section class="detail-section"><div class="detail-section-title"><h2>版本历史</h2><span>Version history</span></div>{history.length?history.map(release=><ReleaseItem release={release} showProduct={false}/>):<p class="muted">尚无公开发布记录。</p>}</section>
    <section class="detail-section"><div class="detail-section-title"><h2>隐私说明</h2><span>Privacy</span></div>{product.privacyText?<p class="prose">{product.privacyText}</p>:!product.privacyUrl&&<p class="muted">隐私说明尚未提供。</p>}{product.privacyUrl&&<a class="text-link" href={url(product.privacyUrl)}>查看隐私说明<Arrow diagonal/></a>}</section>
    <section class="detail-section"><div class="detail-section-title"><h2>反馈</h2><span>Feedback</span></div>{product.feedbackUrl?<a class="text-link" href={url(product.feedbackUrl)}>反馈问题或建议<Arrow diagonal/></a>:<p class="muted">反馈入口尚未提供。</p>}</section>
  </div><aside class="product-sidebar" aria-label="产品信息与下载"><div class="sidebar-inner"><span class="eyebrow">Product information</span><dl class="metadata"><div><dt>平台</dt><dd>{product.platforms.map(platformName).join(' / ')}</dd></div><div><dt>状态</dt><dd>{product.status?statusName(product.status):'—'}</dd></div><div><dt>当前版本</dt><dd>{latest?.version || '—'}</dd></div><div><dt>发布日期</dt><dd>{dateText(latest?.date)}</dd></div><div><dt>内容更新</dt><dd>{dateText(product.updatedAt)}</dd></div><div><dt>文件大小</dt><dd>{releaseFiles.length===1?(releaseFiles[0].size||'—'):releaseFiles.length>1?'见各下载文件':'—'}</dd></div><div><dt>系统要求</dt><dd>{releaseFiles.length===1?(releaseFiles[0].minimumSystem||'—'):releaseFiles.length>1?'见各下载文件':'—'}</dd></div></dl>
    <div class="download-panel"><h2>Downloads / Visit</h2>{releaseFiles.length?releaseFiles.map(file=><a class="file-link" href={url(file.url)} download={file.url.startsWith('/')?true:undefined}><span>{file.label||'Download'} <span class="file-format">{file.format}</span><small>{platformName(file.platform)}{file.size&&` · ${file.size}`}{file.minimumSystem&&` · ${file.minimumSystem}`}</small></span><span aria-hidden="true">↓</span></a>):product.downloadUrl?<a class="button" href={url(product.downloadUrl)}>Download<span aria-hidden="true">↓</span></a>:!primaryVisit&&<div class="unavailable"><span>下载信息待补充</span><span aria-hidden="true">—</span></div>}{primaryVisit&&<a class="button" href={url(primaryVisit)}>Visit<Arrow diagonal/></a>}{product.repositoryUrl&&<a class="text-link" href={url(product.repositoryUrl)}>Repository<Arrow diagonal/></a>}</div>
  </div></aside></div>
  {nextProduct&&nextProduct.id!==product.id&&<div class="container next-product"><span class="eyebrow">Explore another product</span><a href={url(`/products/${nextProduct.slug}/`)}>{nextProduct.name}<Arrow diagonal/></a></div>}
</Layout>
