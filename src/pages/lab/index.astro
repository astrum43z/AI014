---
import Layout from '../../layouts/Layout.astro';import PageHeading from '../../components/PageHeading.astro';import Media from '../../components/Media.astro';import Arrow from '../../components/Arrow.astro';
import {labs,url,typeName,statusName} from '../../lib/content';
---
<Layout active="Lab" title="Lab — AI014" description="AI014 Lab。留一点空间，给还没成形的想法。"><PageHeading label="AI014 / Open-ended experiments" title="Lab" description="留一点空间，给还没成形的想法。"/>
  <section class="container lab-page" aria-label="实验记录">{labs.length?labs.map(lab=><article class="lab-entry" id={lab.slug}><div class="eyebrow">{lab.number&&`LAB ${lab.number} / `}{typeName(lab.type)}{lab.status&&` / ${statusName(lab.status)}`}{lab.year&&` / ${lab.year}`}</div><h2>{lab.name}</h2><p class="prose">{lab.description}</p>{lab.tags.length>0&&<div class="tags">{lab.tags.map(tag=><span>{tag}</span>)}</div>}{lab.cover&&<Media src={lab.cover} alt={lab.name}/>}<div class="screenshot-grid">{lab.images.map(s=><figure><Media {...s}/><figcaption>{s.alt}</figcaption></figure>)}</div>{lab.technicalNotes&&<p class="prose">{lab.technicalNotes}</p>}{lab.developmentNotes.length>0&&<ul class="changelog">{lab.developmentNotes.map(note=><li>{note}</li>)}</ul>}<div class="project-links">{lab.visitUrl&&<a class="text-link" href={url(lab.visitUrl)}>Explore<Arrow diagonal/></a>}{lab.repositoryUrl&&<a class="text-link" href={url(lab.repositoryUrl)}>Repository<Arrow diagonal/></a>}</div></article>):<div class="lab-empty"><div class="lab-empty-top"><span>AI014 LAB</span><span aria-hidden="true">[ &nbsp; ]</span></div><div class="lab-empty-center"><span class="lab-empty-bracket" aria-hidden="true">[</span><div><h2>Nothing here yet.</h2><p>尚无公开实验。</p></div><span class="lab-empty-bracket" aria-hidden="true">]</span></div><div class="lab-empty-bottom"><span>Ideas are welcome here.</span><span aria-hidden="true">＋</span></div></div>}</section>
</Layout>
