{
  "name": "ai014",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "node scripts/validate.mjs && node scripts/images.mjs && astro build && node scripts/verify-build.mjs",
    "preview": "astro preview --host 127.0.0.1",
    "check": "node scripts/validate.mjs && astro check",
    "test": "node --test tests/*.test.mjs",
    "images": "node scripts/images.mjs",
    "dev:stop": "astro dev stop"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "astro": "^7.3.2",
    "sharp": "^0.35.4",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "lighthouse": "^13.4.1"
  }
}
